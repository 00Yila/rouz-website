# Booking emails are sent through Resend (https://resend.com)
# Use a sending-only key restricted to your sending domain, not a full-access key
RESEND_API_KEY=
# Reception inbox(es), comma-separated
BOOKING_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Rouz Bookings <bookings@yourdomain.com>"
BOOKING_FROM_EMAIL=
